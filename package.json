{
  "name": "git",
  "version": "1.0.0",
  "description": "Web-based git browser for Solid pods",
  "scripts": {
    "build": "esbuild src/app.js --bundle --outfile=app.js --format=esm --target=es2022 --alias:crypto=crypto-browserify --alias:stream=stream-browserify --define:global=globalThis --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavaScriptSolidServer/git.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JavaScriptSolidServer/git/issues"
  },
  "homepage": "https://github.com/JavaScriptSolidServer/git#readme",
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "crypto-browserify": "^3.12.1",
    "htm": "^3.1.1",
    "isomorphic-git": "^1.37.6",
    "marked": "^18.0.3",
    "preact": "^10.29.1",
    "stream-browserify": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
